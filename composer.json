{
    "name": "hval/nexi-php",
    "description": "Unofficial PHP library for the Nexi XPay payment gateway: HPP, Pay-by-Link, recurring contracts, operations and webhooks",
    "type": "library",
    "license": "MIT",
    "keywords": ["nexi", "xpay", "payment", "gateway", "hpp", "hosted-payment-page", "pay-by-link", "recurring", "contracts", "webhooks"],
    "authors": [
        {
            "name": "Hermann Vallieri",
            "email": "hermann@vallieri.email"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.12",
        "nyholm/psr7": "^1.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "nyholm/psr7": "Lightweight PSR-7 and PSR-17 implementation"
    },
    "autoload": {
        "psr-4": {
            "Hval\\Nexi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hval\\Nexi\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    }
}
